# Supabase — MUST be project sepzceaicoldqhyxxzff (not ajfhzylokauqcjrokizx).
# On Vercel, set these in Production env vars, or rely on .env.production + vite build override.
VITE_SUPABASE_URL=https://sepzceaicoldqhyxxzff.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_from_dashboard
# Use `public` (default) until lc schema is exposed in Supabase API settings, then set to `lc`
# VITE_SUPABASE_DB_SCHEMA=lc

# Backend API
# Local dev:
VITE_API_URL=http://localhost:5000/api/v1
# Vercel production (optional — defaults to /api/v1 same-origin proxy):
# VITE_API_URL=/api/v1

# ---------------------------------------------------------------------------
# Live realtime speaking examiner
# ---------------------------------------------------------------------------
# The OpenAI key is SERVER-SIDE ONLY and is read by server/realtime-bridge.mjs.
# Never prefix it with VITE_ — Vite inlines every VITE_* var into the browser
# bundle, which would publish the key to anyone who opens devtools.
# OPENAI_API_KEY=sk-proj-...
#
# Start the bridge with:  npm run realtime      (or npm run dev:realtime)
# WS endpoint the browser connects to (no secret in this value):
# VITE_REALTIME_EXAM_WS_URL=ws://localhost:8787/realtime/speaking
# Set to 1 to open the speaking task directly in live examiner mode:
# VITE_REALTIME_EXAM_DEFAULT=1
#
# Optional bridge tuning (all server-side, all have sane defaults):
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=cedar               # marin, cedar, alloy, ...
# REALTIME_NUDGE_1_MS=8000           # silence before "Are you there?"
# REALTIME_NUDGE_2_MS=10000          # further silence before moving on
# REALTIME_MAX_EXAM_MS=900000        # hard 15-minute ceiling
# REALTIME_MAX_CONSECUTIVE_SKIPS=2   # abandon after N unanswered questions
# REALTIME_MAX_CONCURRENT=4          # concurrent exams this bridge will run
# REALTIME_BRIDGE_PORT=8787

# Legacy per-question WS scoring bridge (unrelated to the live examiner).
# Leave unset to score recordings over REST.
# VITE_REALTIME_SPEAKING_WS_URL=wss://your-domain.example.com/realtime/speaking

# Vercel server-side only (NOT VITE_): Railway public domain for api/[...slug].ts proxy
# BACKEND_URL=https://YOUR-SERVICE.up.railway.app

# Optional (Stripe checkout / portal — next phase)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
