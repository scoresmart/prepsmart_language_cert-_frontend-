# Supabase — MUST be project sepzceaicoldqhyxxzff (not ajfhzylokauqcjrokizx).
# On Vercel, set these in Production env vars, or rely on .env.production + vite build override.
VITE_SUPABASE_URL=https://sepzceaicoldqhyxxzff.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_from_dashboard
# Use `public` (default) until lc schema is exposed in Supabase API settings, then set to `lc`
# VITE_SUPABASE_DB_SCHEMA=lc

# Backend API
# Local dev:
VITE_API_URL=http://localhost:5000/api/v1
# Vercel production (optional — defaults to /api/v1 same-origin proxy):
# VITE_API_URL=/api/v1

# Realtime speaking (optional)
# Configure your backend WS bridge that forwards audio to Azure/OpenAI realtime and returns a final speaking score payload.
# When this is set, speaking scoring uses WebSocket first and falls back to REST if unset.
# VITE_REALTIME_SPEAKING_WS_URL=wss://your-domain.example.com/realtime/speaking
# Optional for WS bridges that expect key/token inside the start payload:
# VITE_REALTIME_SPEAKING_API_KEY=your_realtime_api_key

# Vercel server-side only (NOT VITE_): Railway public domain for api/[...slug].ts proxy
# BACKEND_URL=https://YOUR-SERVICE.up.railway.app

# Optional (Stripe checkout / portal — next phase)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
